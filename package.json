{
  "name": "consumer-csv-matcher",
  "version": "1.0.0",
  "description": "Browser-only, high-volume consumer CSV matching and extraction (React + Web Workers + DuckDB-Wasm)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "gen:data": "tsx scripts/generate-test-data.ts",
    "bench": "node --expose-gc --max-old-space-size=4096 --import tsx scripts/benchmark.ts",
    "bench:browser": "tsx scripts/browser-e2e.ts",
    "bench:xlsx": "tsx scripts/bench-xlsx.ts",
    "test:full": "FULL=1 vitest run tests/compare.test.ts",
    "test:browser": "tsx scripts/browser-features.ts",
    "compare:offline": "tsx scripts/compare-offline.ts samples"
  },
  "license": "MIT",
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}
